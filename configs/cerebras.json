{
  "name": "Cerebras",
  "id": "cerebras",
  "api_key": "$CEREBRAS_API_KEY",
  "api_endpoint": "https://api.cerebras.ai/v1",
  "type": "openai-compat",
  "doc": "https://inference-docs.cerebras.ai/models/overview",
  "default_large_model_id": "gpt-oss-120b",
  "default_small_model_id": "gemma-4-31b",
  "models": [
    {
      "id": "gpt-oss-120b",
      "modelCode": "openai/gpt-oss-120b",
      "name": "OpenAI GPT OSS",
      "reasoning": true,
      "reasoning_options": [
        {
          "type": "effort",
          "values": [
            "low",
            "medium",
            "high"
          ]
        }
      ],
      "attachment": false,
      "limit": {
        "context": 131072,
        "output": 25000
      },
      "cost": {
        "input": 0.35,
        "output": 0.75,
        "cache_read": 0,
        "cache_write": 0
      }
    },
    {
      "id": "gemma-4-31b",
      "modelCode": "google/gemma-4-31b",
      "name": "Gemma 4 31B",
      "reasoning": true,
      "reasoning_options": [
        {
          "type": "effort",
          "values": [
            "low",
            "medium",
            "high"
          ]
        }
      ],
      "attachment": true,
      "limit": {
        "context": 131072,
        "output": 25000
      },
      "cost": {
        "input": 0.99,
        "output": 1.49,
        "cache_read": 0,
        "cache_write": 0
      }
    }
  ],
  "default_headers": {
    "X-Cerebras-3rd-Party-Integration": "crush"
  }
}
